#!/usr/bin/env bash
#
# test/run: tests of memex-jira, offline.
#
# curl is test/bin/curl, a fake that answers from fixtures in
# test/fixtures and logs what the adapter asked. Each test gets its own
# routes, log and HOME under a temporary directory; JIRA_USER and
# JIRA_PASSWORD are unset unless the test sets them.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ADAPTER=$(dirname "$CURDIR")/memex-jira
ADDR=https://jira.example.org
API=$ADDR/rest/api/2
# A password curl's config must quote
SECRET='pa"ss\word'
DIR=$(mktemp -d)
FAILED=0

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  rm -rf "$DIR"
}

# Answer METHOD URL with test/fixtures/FIXTURE, or nothing for -, and
# HTTP status CODE, 200 by default
route() {
  echo "$1 $2 $3 ${4:-200}" >> "$FAKE/routes"
}

# Run the adapter's tracker role: ARGS, stdin from IN; sets OUT, ERR and
# STATUS
call() {
  STATUS=0
  "$ADAPTER" "$ADDR" tracker "$@" < "$IN" > "$TEST_DIR/out" \
    2> "$TEST_DIR/err" || STATUS=$?
  OUT=$(< "$TEST_DIR/out")
  ERR=$(< "$TEST_DIR/err")
}

# jq FILTER on the records printed, as one array
records() {
  jq -scr "$1" <<< "$OUT"
}

# jq FILTER on the requests curl got, as one array
requests() {
  touch "$FAKE/log"
  jq -scr "$1" "$FAKE/log"
}

login() {
  export JIRA_USER=jdoe JIRA_PASSWORD=$SECRET
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ $2 == *"$3"* ]] && return
  echo "# $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

# Compare jq FILTER on the records with the JSON on stdin
check_json() {
  check "$1" "$(jq -sc "$2" <<< "$OUT" | jq -cS .)" "$(jq -cS .)"
}

# Fails a test that asked for something without a route or put the
# password on curl's command line
audit() {
  local bad
  [ -f "$FAKE/log" ] || return 0
  bad=$(jq -r --arg secret "$SECRET" '
      if .unexpected then "unexpected request: \(.method) \(.url)"
      elif (.args + [.url] | any(contains($secret)))
      then "password on the command line: \(.url)"
      else empty end' "$FAKE/log")
  [ -n "$bad" ] || return 0
  sed 's/^/# /' <<< "$bad"
  FAILED=$((FAILED + 1))
}

test_capabilities() {
  call capabilities
  check status "$STATUS" 0
  check capabilities "$(records '.[0] | tojson')" \
    '{"search":true,"comment":true,"transition":true}'
  check requests "$(requests length)" 0
}

test_other_role() {
  STATUS=0
  "$ADAPTER" "$ADDR" ci capabilities < "$IN" 2> /dev/null || STATUS=$?
  check status "$STATUS" 2
}

test_unknown_command() {
  call locate 4a2f
  check status "$STATUS" 2
}

test_usage() {
  call issue
  check "no issue" "$STATUS" 1
  call transition LU-930
  check "no status" "$STATUS" 1
  STATUS=0
  "$ADAPTER" jira.example.org tracker issue LU-930 < "$IN" 2> /dev/null ||
    STATUS=$?
  check "not a URL" "$STATUS" 1
  check requests "$(requests length)" 0
}

test_not_a_key() {
  call issue 'LU-930&fields=*all'
  check status "$STATUS" 1
  check_has error "$ERR" 'Not an issue key'
  check requests "$(requests length)" 0
}

FIELDS='summary,issuetype,status,priority,assignee,reporter,created,updated'
FIELDS+=',description,issuelinks,parent,subtasks'

# LU-930 and its comments, in two pages
route_lu930() {
  route GET "$API/issue/LU-930?fields=$FIELDS" issue-LU-930.json
  route GET "$API/issue/LU-930/comment?startAt=0&maxResults=100" \
    comments-LU-930-0.json
  route GET "$API/issue/LU-930/comment?startAt=2&maxResults=100" \
    comments-LU-930-2.json
}

# LU-3425, a closed subtask of LU-930 without comments
route_lu3425() {
  route GET "$API/issue/LU-3425?fields=$FIELDS" issue-LU-3425.json
  route GET "$API/issue/LU-3425/comment?startAt=0&maxResults=100" \
    comments-empty.json
}

test_issue() {
  route_lu930
  call issue LU-930
  check status "$STATUS" 0
  check count "$(records length)" 1
  check_json envelope '.[0] | del(.data)' << 'EOF'
{"id": "LU-930", "source": "https://jira.example.org", "role": "tracker",
 "kind": "issue", "basis": "2026-10-21T17:40:01.000+0000",
 "links": [["issue", "LU-930"]], "notes": {}}
EOF
  check_json data '.[0].data | del(.comments)' << 'EOF'
{"title": "Update or improvement to a Lustre man page or documentation",
 "type": "Improvement", "status": "Open", "closed": false,
 "priority": "Minor",
 "assignee": {"name": "John Roe", "email": "jroe@example.org",
              "username": "jroe", "me": false},
 "reporter": {"name": "Jane Doe", "email": null, "username": "jdoe",
              "me": false},
 "created": "2011-12-15T13:50:27+00:00",
 "updated": "2026-10-21T17:40:01+00:00",
 "url": "https://jira.example.org/browse/LU-930",
 "text": "Trivial changes to man pages,\r\ndocumentation or messages.",
 "related": [["is related to", "LU-19273"], ["blocks", "LU-9633"],
             ["subtask", "LU-3425"], ["subtask", "LU-4466"]]}
EOF
  check comments "$(records '[.[0].data.comments[].id] | join(" ")')" \
    '166106 166200 170001'
  check_json comment '.[0].data.comments[1]' << 'EOF'
{"id": "166200",
 "author": {"name": "Jane Doe", "email": null, "username": "jdoe",
            "me": false},
 "text": "Thanks, that covers it.", "created": "2016-09-16T10:02:11-06:00"}
EOF
  check anonymous "$(requests '[.[].auth] | unique | tojson')" '[null]'
}

test_issue_trailing_slash() {
  route_lu930
  ADDR=$ADDR/
  call issue LU-930
  check status "$STATUS" 0
  check source "$(records '.[0].source')" https://jira.example.org
  check url "$(records '.[0].data.url')" https://jira.example.org/browse/LU-930
}

test_issue_closed_subtask() {
  route_lu3425
  call issue LU-3425
  check status "$STATUS" 0
  check status "$(records '.[0].data.status')" Resolved
  check closed "$(records '.[0].data.closed')" true
  check nulls "$(records '.[0].data | [.priority, .assignee] | tojson')" \
    '[null,null]'
  check text "$(records '.[0].data.text | tojson')" '""'
  check related "$(records '.[0].data.related | tojson')" \
    '[["parent","LU-930"]]'
  check comments "$(records '.[0].data.comments | tojson')" '[]'
}

# The password goes to curl in its config on stdin
test_issue_logged_in() {
  login
  route GET "$API/myself" myself-server.json
  route_lu930
  call issue LU-930
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | tojson')" '["stdin"]'
  check user "$(requests '[.[].user] | unique | .[]')" "jdoe:$SECRET"
  check reporter "$(records '.[0].data.reporter.me')" true
  check assignee "$(records '.[0].data.assignee.me')" false
  check comments "$(records '[.[0].data.comments[].author.me] | tojson')" \
    '[false,true,false]'
}

test_issue_netrc() {
  echo 'machine jira.example.org login jdoe password x' > "$HOME/.netrc"
  route GET "$API/myself" myself-server.json
  route_lu930
  call issue LU-930
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | tojson')" '["netrc"]'
  check reporter "$(records '.[0].data.reporter.me')" true
}

test_issue_netrc_other_host() {
  echo 'machine jira.example.com login jdoe password x' > "$HOME/.netrc"
  route_lu930
  call issue LU-930
  check status "$STATUS" 0
  check auth "$(requests '[.[].auth] | unique | tojson')" '[null]'
}

# Cloud names people by accountId, without a username
test_issue_cloud() {
  login
  route GET "$API/myself" myself-cloud.json
  route GET "$API/issue/EX-1?fields=$FIELDS" issue-cloud.json
  route GET "$API/issue/EX-1/comment?startAt=0&maxResults=100" \
    comments-cloud.json
  call issue EX-1
  check status "$STATUS" 0
  check assignee "$(records '.[0].data.assignee | tojson')" \
    '{"name":"Jane Doe","email":null,"username":null,"me":true}'
  check_json reporter '.[0].data.reporter' << 'EOF'
{"name": "John Roe", "email": "jroe@example.org", "username": null,
 "me": false}
EOF
  check comment "$(records '.[0].data.comments[0].author.me')" true
  check times "$(records '.[0].data | [.created, .updated] | join(" ")')" \
    '2026-10-01T09:00:00+01:00 2026-10-02T09:30:00+01:00'
  check closed "$(records '.[0].data.closed')" false
}

test_issue_missing() {
  route GET "$API/issue/LU-1?fields=$FIELDS" error.json 404
  call issue LU-1
  check status "$STATUS" 1
  check_has error "$ERR" "Cannot read $API/issue/LU-1"
  check output "$OUT" ''
}

test_issue_comments_fail() {
  route GET "$API/issue/LU-930?fields=$FIELDS" issue-LU-930.json
  route GET "$API/issue/LU-930/comment?startAt=0&maxResults=100" - 500
  call issue LU-930
  check status "$STATUS" 1
  check output "$OUT" ''
}

test_issue_login_fails() {
  login
  route GET "$API/myself" - 401
  call issue LU-930
  check status "$STATUS" 1
  check requests "$(requests length)" 1
}

# The QUERY, URL-encoded, and the first page of keys
JQL=project%20%3D%20LU%20ORDER%20BY%20key
PAGE='fields=key&startAt=0&maxResults=100'

# Server pages by startAt
test_search_server() {
  printf 'project = LU ORDER BY key\n\n' > "$IN"
  route GET "$API/serverInfo" serverinfo-server.json
  route GET "$API/search?jql=$JQL&$PAGE" search-0.json
  route GET "$API/search?jql=$JQL&fields=key&startAt=1&maxResults=100" \
    search-1.json
  route_lu930
  route_lu3425
  call search
  check status "$STATUS" 0
  check issues "$(records '[.[].id] | join(" ")')" 'LU-930 LU-3425'
  check kinds "$(records '[.[].kind] | unique | join(" ")')" issue
}

# Cloud has search/jql, which pages by token
test_search_cloud() {
  local token='&nextPageToken=Ch0jU3RyaW5nJlRGVT0%3D%2F1'
  printf 'project = LU ORDER BY key' > "$IN"
  route GET "$API/serverInfo" serverinfo-cloud.json
  route GET "$API/search/jql?jql=$JQL&fields=key&maxResults=100" \
    search-jql-1.json
  route GET "$API/search/jql?jql=$JQL&fields=key&maxResults=100$token" \
    search-jql-2.json
  route_lu930
  route_lu3425
  call search
  check status "$STATUS" 0
  check issues "$(records '[.[].id] | join(" ")')" 'LU-930 LU-3425'
}

test_search_nothing() {
  echo 'project = NONE' > "$IN"
  route GET "$API/serverInfo" serverinfo-server.json
  route GET "$API/search?jql=project%20%3D%20NONE&$PAGE" search-empty.json
  call search
  check status "$STATUS" 0
  check output "$OUT" ''
}

test_search_no_query() {
  printf ' \n' > "$IN"
  call search
  check status "$STATUS" 1
  check requests "$(requests length)" 0
}

test_search_fails() {
  echo 'project = LU' > "$IN"
  route GET "$API/serverInfo" serverinfo-server.json
  route GET "$API/search?jql=project%20%3D%20LU&$PAGE" error.json 400
  call search
  check status "$STATUS" 1
  check output "$OUT" ''
}

run() {
  local failed=$FAILED
  TEST=$1
  TEST_DIR=$DIR/$1
  IN=$TEST_DIR/in
  mkdir -p "$TEST_DIR/home"
  : > "$IN"
  (
    export HOME=$TEST_DIR/home
    export FAKE=$TEST_DIR
    "$1"
    audit
    exit $((FAILED - failed))
  ) || FAILED=$((FAILED + $?))
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
trap cleanup EXIT
export PATH=$CURDIR/bin:$PATH
[ "$(command -v curl)" == "$CURDIR/bin/curl" ] || die "curl is not the fake"
export FIXTURES=$CURDIR/fixtures
unset JIRA_USER JIRA_PASSWORD

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
